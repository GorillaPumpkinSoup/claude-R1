# Claude API 키. 비워두면 LLM 시장 해설은 건너뛰고 규칙 기반 지표만 표시합니다.
ANTHROPIC_API_KEY=

# LLM 해설에 사용할 모델. 매시간 자동 호출되므로 비용을 고려해 선택하세요.
# (claude-opus-5가 가장 정확하지만 비용이 높습니다. 비용을 낮추려면 claude-sonnet-5 또는 claude-haiku-4-5)
CLAUDE_MODEL=claude-opus-5

# 보유 자산 정의 파일 경로 (config/portfolio.example.yaml을 복사해서 만드세요)
PORTFOLIO_FILE=config/portfolio.yaml

# 스냅샷을 저장할 SQLite DB 경로
DB_PATH=data/portfolio.db

# 자동 갱신 주기(분). 기본 60분(매시간)
REFRESH_INTERVAL_MINUTES=60
